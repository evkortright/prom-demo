// Paste this into Kibana Dev Tools to test the pipeline against
// representative documents without writing to any index.
//
// This uses the Elasticsearch Pipeline Simulate API — it runs the pipeline
// against the provided documents and returns what would be indexed,
// without actually indexing anything.
//
// Tests all three domains: HTTP, gRPC, and Database.

POST _ingest/pipeline/metrics-generic.prometheus@custom/_simulate
{
  "docs": [
    {
      "_source": {
        "@timestamp": "2026-09-25T16:10:23.775Z",
